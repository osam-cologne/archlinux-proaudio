# Maintainer: OSAMC <https://github.com/osam-cologne/archlinux-proaudio>

pkgname=calfnxt
pkgver=2.17.0
pkgrel=1
pkgdesc='Successor to the Calf Studio Gear audio plugin suite with web GUIs'
arch=(aarch64 x86_64)
url='https://calfnxt.org/'
license=(GPL-3.0-or-later)
groups=(pro-audio vst3-plugins)
depends=(
  glib2
  glibc
  gtk3
  gtk4
  libgcc
  libstdc++
  libsoup3
  libx11
  webkit2gtk-4.1
  webkitgtk-6.0
)
makedepends=(cmake git ninja python vst3sdk)
optdepends=('vst3-host: for running the VST3 plugin')
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/boomshop/calfnxt/archive/refs/tags/v$pkgver.tar.gz"
  "calfnxt-ui-dist.tar.xz::https://github.com/boomshop/calfnxt/releases/download/v$pkgver/calfnxt-$pkgver-ui-dist.tar.xz"
  "calfnxt-unvendor-vst3sdk.patch"
)
sha256sums=('6dbd8ce6a759e184e0c79c31b9a845425872ad3a125acbd236683ecb62a50743'
            'dd855ea576f2b27fbc9c6f3cdac210f3db5b249e6c8ea7acb45248733932cd91'
            'a747bbb29b140414aa11e8296fc5f5ca205503ad4bacbb14ec541a552a4d5387')

prepare() {
  cd $pkgname-$pkgver
  rm -f ui/dist; mkdir -p ui; ln -s "$srcdir"/ui/dist ui/dist
  patch -p1 -N -r - -i "$srcdir"/calfnxt-unvendor-vst3sdk.patch
}

build() {
  # Project requires build type set to DEVELOPMENT, RELEASE, _DEBUG, or NDEBUG
  local cmake_options=(
    -B build-$pkgname
    -S $pkgname-$pkgver
    -W no-author
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CALFNXT_USE_PREBUILT_UI=ON
    -G Ninja
  )
  cmake "${cmake_options[@]}"
  cmake --build build-$pkgname
}

package() {
  DESTDIR="$pkgdir" cmake --install build-$pkgname --prefix /usr

  # De-duplicate fonts
  install -vDm 644 \
    "$srcdir"/$pkgname-$pkgver/ui/dist/assets/AUXIcons-*.ttf \
    "$srcdir"/$pkgname-$pkgver/ui/dist/assets/{Oswald-Regular,PragatiNarrow-Regular}-*.woff2 \
    -t "$pkgdir"/usr/share/$pkgname/assets
  for _bundle in "$pkgdir"/usr/lib/vst3/*.vst3; do
    rm -v "$_bundle"/Contents/Resources/assets/*.{ttf,woff2}
    for _font in "$pkgdir"/usr/share/$pkgname/assets/*.{ttf,woff2}; do
      local _fn="${_font##*/}"
      ln -vs /usr/share/$pkgname/assets/"$_fn" "$_bundle"/Contents/Resources/assets
    done
  done

  # additional license information
  install -vDm 644 "$srcdir"/$pkgname-$pkgver/COPYRIGHT \
    -t "$pkgdir"/usr/share/licenses/$pkgname
}
